// =====================================================================
// RESERVAS: espacios, mesas, turnos, reglas y reservas de cada local.
// Ficha: docs/specs/modulos/reservas/README.md
// Referencias al núcleo (tenantId, centroId, usuarioId) y a otros módulos
// (clienteId, solicitudEventoId) solo con id de texto, sin @relation.
// =====================================================================

enum TipoEspacioReserva {
  SALA
  TERRAZA
  RESERVADO
  BARRA
}

/// Zona del local con su aforo (sala, terraza, reservado…)
model ReservaEspacio {
  id        String             @id @default(cuid())
  tenantId  String
  centroId  String
  nombre    String // «Sala principal», «Reservado Socarrat»
  tipo      TipoEspacioReserva @default(SALA)
  aforo     Int                @default(0) // personas como máximo a la vez
  orden     Int                @default(0)
  // tamaño del lienzo del plano (unidades del plano; 1 unidad ≈ 1 px a escala 1)
  ancho     Int                @default(800)
  alto      Int                @default(500)
  activo    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  mesas     ReservaMesa[]

  @@index([tenantId, centroId])
}

enum FormaMesa {
  CUADRADA
  REDONDA
  RECTANGULAR
}

model ReservaMesa {
  id                 String                @id @default(cuid())
  tenantId           String
  centroId           String
  espacioId          String
  espacio            ReservaEspacio        @relation(fields: [espacioId], references: [id])
  nombre             String // «12», «R1»
  capacidadMin       Int                   @default(1)
  capacidadMax       Int                   @default(4)
  x                  Int                   @default(0) // posición en el plano (esquina superior izquierda)
  y                  Int                   @default(0)
  ancho              Int                   @default(60)
  alto               Int                   @default(60)
  forma              FormaMesa             @default(CUADRADA)
  combinable         Boolean               @default(false) // se puede juntar con otra combinable del mismo espacio
  reservableInternet Boolean               @default(true)
  especial           String? // «Ventana», «Chimenea»: condición o suplemento
  activo             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  asignaciones       ReservaMesaAsignada[]

  @@index([tenantId, centroId])
}

/// Turno de un local (comida, cena) con días, horas de entrada, duración y ritmo de entradas
model ReservaTurno {
  id                 String   @id @default(cuid())
  tenantId           String
  centroId           String
  nombre             String // Comida, Cena
  dias               Int[] // 1 = lunes … 7 = domingo
  horaInicio         String // primera entrada «13:00»
  horaFin            String // última entrada «15:30»
  duracionMin        Int      @default(90) // duración de mesa
  intervaloMin       Int      @default(15) // tamaño de la franja de entradas
  maxCubiertosFranja Int      @default(30) // máximo de personas que entran en cada franja
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, centroId])
}

/// Reglas de reserva de un local (una fila por local)
model ReservaAjustes {
  id                  String   @id @default(cuid())
  tenantId            String
  centroId            String   @unique
  grupoMaximo         Int      @default(10) // más de esto → solicitud de evento
  antelacionMinutos   Int      @default(60) // antelación mínima para reservas por internet
  elegirMesaInternet  Boolean  @default(false) // el cliente puede elegir mesa en la web (fase R3)
  duracionPorPersonas Json? // { "2": 90, "4": 105, "8": 120 } minutos según personas (opcional)
  updatedAt           DateTime @updatedAt
}

enum EstadoReserva {
  SOLICITADA
  CONFIRMADA
  LLEGADA
  SENTADA
  TERMINADA
  CANCELADA
  NO_PRESENTADA
}

enum OrigenReserva {
  MANUAL
  TELEFONO
  WEB
  COVERMANAGER
}

model Reserva {
  id                String                @id @default(cuid())
  tenantId          String
  centroId          String
  clienteId         String? // módulo Clientes (si está contratado)
  nombre            String
  telefono          String? // internacional: +34…
  email             String?
  personas          Int
  fecha             DateTime              @db.Date // día de la reserva (jornada)
  hora              String // «21:15»
  duracionMin       Int                   @default(90)
  espacioId         String? // zona pedida (ReservaEspacio)
  estado            EstadoReserva         @default(CONFIRMADA)
  origen            OrigenReserva         @default(MANUAL)
  notas             String?
  alergias          String?
  externoId         String? // id en CoverManager u otro
  solicitudEventoId String? // si se convirtió en evento
  creadoPor         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  mesas             ReservaMesaAsignada[]
  historial         ReservaHistorial[]

  @@index([tenantId, centroId, fecha])
  @@index([tenantId, clienteId])
}

model ReservaMesaAsignada {
  id        String      @id @default(cuid())
  reservaId String
  reserva   Reserva     @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  mesaId    String
  mesa      ReservaMesa @relation(fields: [mesaId], references: [id])

  @@unique([reservaId, mesaId])
}

/// Historial de estados de cada reserva
model ReservaHistorial {
  id        String         @id @default(cuid())
  reservaId String
  reserva   Reserva        @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  desde     EstadoReserva?
  hasta     EstadoReserva
  nota      String?
  usuarioId String?
  createdAt DateTime       @default(now())
}
