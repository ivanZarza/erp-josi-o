// =====================================================================
// CONTABILIDAD: facturas recibidas y emitidas (preparadas), gastos,
// categorías contables sencillas, pagos y cobros. Todo por sociedad.
// El ERP NO lleva la contabilidad oficial: exporta a la gestoría.
// Referencias al núcleo (sociedad, centro, proveedor, pedido) con id de texto, sin @relation.
// Ver docs/specs/modulos/contabilidad/README.md
// =====================================================================

/// Grupo de la categoría: decide dónde suma en el Cuadro de mando
enum GrupoCategoriaContable {
  MERCANCIA // compras de bebida, comida, consumibles
  PERSONAL
  GASTO_FIJO // alquiler, seguros, suministros…
  GASTO_VARIABLE // mantenimiento, publicidad, comisiones…
  INGRESO
}

/// Plan de cuentas sencillo por categorías (mercancía de bebidas, alquiler…)
model CategoriaContable {
  id             String                 @id @default(cuid())
  tenantId       String
  codigo         String // MERC-BEB, ALQ…
  nombre         String
  grupo          GrupoCategoriaContable
  cuentaGestoria String? // cuenta en el programa de la gestoría (600, 621…) cuando se sepa (P-04)
  orden          Int                    @default(0)
  activo         Boolean                @default(true)
  createdAt      DateTime               @default(now())

  @@unique([tenantId, codigo])
}

enum EstadoFacturaRecibida {
  PENDIENTE // pendiente de revisar
  VALIDADA
  PAGADA
  ANULADA
}

enum OrigenFacturaRecibida {
  MANUAL
  LECTURA_IA // hueco: lectura de PDF o foto con IA
  ELECTRONICA // hueco: factura electrónica de proveedor (Orden HAC/1028/2026)
}

model FacturaRecibida {
  id              String                 @id @default(cuid())
  tenantId        String
  numero          String // número interno FR-000001
  numeroProveedor String // número de la factura del proveedor
  proveedorId     String? // Proveedor del núcleo (si está dado de alta)
  proveedorNombre String // copia del nombre (o proveedor sin ficha: compañía de la luz, casero…)
  proveedorCif    String?
  sociedadId      String // sociedad que recibe la factura (lo fiscal)
  centroId        String? // centro al que se imputa (lo de gestión); vacío = de la sociedad
  categoriaId     String? // categoría principal (cada línea puede tener la suya)
  fecha           DateTime               @db.Date
  vencimiento     DateTime?              @db.Date
  base            Decimal                @db.Decimal(12, 2)
  cuotaIva        Decimal                @db.Decimal(12, 2)
  total           Decimal                @db.Decimal(12, 2)
  estado          EstadoFacturaRecibida  @default(PENDIENTE)
  origen          OrigenFacturaRecibida  @default(MANUAL)
  pedidoCompraId  String? // cruce con PedidoCompra del núcleo
  archivo         String? // ruta del PDF o foto (cuando haya almacenamiento)
  notas           String?
  creadoPor       String?
  validadaPor     String?
  validadaEn      DateTime?
  pagadaEn        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  lineas          FacturaRecibidaLinea[]

  @@unique([tenantId, numero])
  @@index([tenantId, sociedadId, fecha])
  @@index([tenantId, estado, vencimiento])
}

model FacturaRecibidaLinea {
  id          String          @id @default(cuid())
  facturaId   String
  factura     FacturaRecibida @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  concepto    String
  cantidad    Decimal         @db.Decimal(12, 3)
  precio      Decimal         @db.Decimal(12, 4) // sin IVA
  tipoIva     Decimal         @db.Decimal(5, 2) // 21, 10, 4, 0
  base        Decimal         @db.Decimal(12, 2)
  cuotaIva    Decimal         @db.Decimal(12, 2)
  categoriaId String?
  productoId  String? // Producto del núcleo si se cruza
  orden       Int             @default(0)
}

/// Facturas emitidas: SOLO PREPARADAS. El ERP no está certificado para Verifactu (P-23):
/// la factura oficial se emite en un programa certificado y aquí se apunta su número.
enum EstadoFacturaEmitida {
  BORRADOR
  PREPARADA // lista para emitir en el programa certificado
  EMITIDA_FUERA // emitida en el programa certificado (se guarda su número oficial)
  COBRADA
  ANULADA
}

enum OrigenFacturaEmitida {
  EVENTO
  CATERING
  ENTRE_SOCIEDADES // obrador → local de otra sociedad
  OTRO
}

model FacturaEmitida {
  id                String                @id @default(cuid())
  tenantId          String
  referencia        String // referencia interna del borrador PRE-000001 (NO es número de factura)
  numeroOficial     String? // número que da el programa certificado al emitirla
  programaEmisor    String? // programa certificado donde se emitió
  sociedadId        String
  centroId          String?
  origen            OrigenFacturaEmitida  @default(OTRO)
  clienteNombre     String
  clienteCif        String?
  sociedadDestinoId String? // si es entre sociedades del grupo
  fecha             DateTime              @db.Date
  vencimiento       DateTime?             @db.Date
  base              Decimal               @db.Decimal(12, 2)
  cuotaIva          Decimal               @db.Decimal(12, 2)
  total             Decimal               @db.Decimal(12, 2)
  estado            EstadoFacturaEmitida  @default(BORRADOR)
  notas             String?
  creadoPor         String?
  cobradaEn         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lineas            FacturaEmitidaLinea[]

  @@unique([tenantId, referencia])
  @@index([tenantId, sociedadId, fecha])
}

model FacturaEmitidaLinea {
  id        String         @id @default(cuid())
  facturaId String
  factura   FacturaEmitida @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  concepto  String
  cantidad  Decimal        @db.Decimal(12, 3)
  precio    Decimal        @db.Decimal(12, 4)
  tipoIva   Decimal        @db.Decimal(5, 2)
  base      Decimal        @db.Decimal(12, 2)
  cuotaIva  Decimal        @db.Decimal(12, 2)
  orden     Int            @default(0)
}

enum EstadoGastoContable {
  PENDIENTE // de pagar
  PAGADO
  ANULADO
}

/// Gastos que no son facturas de mercancía: alquiler, suministros, seguros, mantenimiento…
model GastoContable {
  id                String              @id @default(cuid())
  tenantId          String
  sociedadId        String
  centroId          String? // vacío = gasto de la sociedad (oficina, gestoría…)
  categoriaId       String
  fecha             DateTime            @db.Date
  vencimiento       DateTime?           @db.Date
  concepto          String
  proveedorNombre   String?
  base              Decimal             @db.Decimal(12, 2)
  cuotaIva          Decimal             @db.Decimal(12, 2)
  total             Decimal             @db.Decimal(12, 2)
  recurrente        Boolean             @default(false) // gasto fijo mensual
  estado            EstadoGastoContable @default(PENDIENTE)
  facturaRecibidaId String? // si el gasto tiene factura registrada
  notas             String?
  creadoPor         String?
  pagadoEn          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([tenantId, sociedadId, fecha])
  @@index([tenantId, centroId, fecha])
}

enum TipoMovimientoTesoreria {
  PAGO
  COBRO
}

enum FormaPagoContable {
  TRANSFERENCIA
  DOMICILIACION
  TARJETA
  EFECTIVO
  OTRA
}

/// Pagos a proveedores y cobros de clientes (a mano; hueco «Bancos» para leerlos del banco)
model PagoCobro {
  id                String                  @id @default(cuid())
  tenantId          String
  sociedadId        String
  tipo              TipoMovimientoTesoreria
  fecha             DateTime                @db.Date
  importe           Decimal                 @db.Decimal(12, 2)
  forma             FormaPagoContable       @default(TRANSFERENCIA)
  facturaRecibidaId String?
  facturaEmitidaId  String?
  gastoId           String?
  referencia        String?
  usuarioId         String?
  createdAt         DateTime                @default(now())

  @@index([tenantId, sociedadId, fecha])
}
