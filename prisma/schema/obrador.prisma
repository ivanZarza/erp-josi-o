// =====================================================================
// OBRADOR: recetas de producción, órdenes, lotes con trazabilidad y tarifas a locales.
// Ver docs/specs/modulos/obrador/README.md
// Referencias al núcleo (Centro, Producto, Usuario) solo con id de texto, sin @relation.
// =====================================================================

/// Receta de producción: de qué ingredientes sale un elaborado del obrador
model ObradorReceta {
  id            String   @id @default(cuid())
  tenantId      String
  centroId      String // obrador que la produce
  productoId    String // elaborado de salida (Producto del núcleo, área COMIDAS)
  nombre        String
  rendimiento   Decimal  @db.Decimal(12, 3) // cantidad de elaborado que sale de una tanda (en la unidad del producto)
  vidaUtilDias  Int      @default(3)
  conservacion  String? // «Refrigerado 0–4 °C»
  pasos         String?
  tiempoMinutos Int?
  alergenosPropios String[] // los que añade la receta además de los heredados de los ingredientes
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineas  ObradorRecetaLinea[]
  ordenes ObradorOrden[]

  @@unique([tenantId, productoId])
  @@index([tenantId, centroId])
}

/// Ingrediente de una receta: cantidad neta por tanda y merma (la bruta = neta / (1 − merma))
model ObradorRecetaLinea {
  id         String        @id @default(cuid())
  recetaId   String
  receta     ObradorReceta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  productoId String
  cantidad   Decimal       @db.Decimal(12, 4)
  mermaPct   Decimal       @default(0) @db.Decimal(5, 2)
  orden      Int           @default(0)
}

enum EstadoOrdenObrador {
  PLANIFICADA
  CERRADA
  ANULADA
}

/// Orden de producción: se planifica y al cerrarla mueve el stock y crea el lote
model ObradorOrden {
  id               String             @id @default(cuid())
  tenantId         String
  centroId         String
  numero           String // OP-000001
  recetaId         String
  receta           ObradorReceta      @relation(fields: [recetaId], references: [id])
  fecha            DateTime           @db.Date // día previsto de producción
  tandas           Decimal            @db.Decimal(12, 3)
  cantidadPrevista Decimal            @db.Decimal(12, 3)
  cantidadReal     Decimal?           @db.Decimal(12, 3)
  costeTotal       Decimal?           @db.Decimal(12, 4)
  costeUnitario    Decimal?           @db.Decimal(12, 4)
  estado           EstadoOrdenObrador @default(PLANIFICADA)
  notas            String?
  creadoPor        String?
  cerradoPor       String?
  cerradoEn        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lote             ObradorLote?

  @@unique([tenantId, numero])
  @@index([tenantId, centroId, fecha])
}

/// Lote producido: trazabilidad hacia atrás (ingredientes) y etiqueta
model ObradorLote {
  id            String   @id @default(cuid())
  tenantId      String
  centroId      String
  codigo        String // LOTE-000001
  ordenId       String   @unique
  orden         ObradorOrden @relation(fields: [ordenId], references: [id])
  productoId    String
  cantidad      Decimal  @db.Decimal(12, 3)
  costeUnitario Decimal  @db.Decimal(12, 4)
  elaboradoEn   DateTime
  caducaEn      DateTime
  alergenos     String[]
  conservacion  String?
  estado        String   @default("ACTIVO") // ACTIVO | RETIRADO
  retiradoMotivo String?
  retiradoEn    DateTime?
  createdAt     DateTime @default(now())
  ingredientes  ObradorLoteIngrediente[]

  @@unique([tenantId, codigo])
  @@index([tenantId, centroId, caducaEn])
}

model ObradorLoteIngrediente {
  id            String      @id @default(cuid())
  loteId        String
  lote          ObradorLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
  productoId    String
  cantidad      Decimal     @db.Decimal(12, 4) // bruta consumida
  costeUnitario Decimal     @db.Decimal(12, 4)
}

enum ModoTarifaObrador {
  COSTE
  COSTE_MAS_PORCENTAJE
  PRECIO_FIJO
}

/// Cómo se calcula el precio de un artículo del obrador para un local. El precio resultante
/// se escribe en ProductoCentro.precioVenta (núcleo), que es lo que usa el pedido interno.
model ObradorTarifa {
  id          String            @id @default(cuid())
  tenantId    String
  obradorId   String
  productoId  String
  centroId    String // local destino
  modo        ModoTarifaObrador @default(COSTE_MAS_PORCENTAJE)
  porcentaje  Decimal?          @db.Decimal(6, 2)
  precioFijo  Decimal?          @db.Decimal(12, 4)
  actualizadoPor String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tenantId, productoId, centroId])
  @@index([tenantId, obradorId])
}
